---
/**
 * InstallOneLiner — the per-tool one-step install one-liner for tool overviews.
 *
 * Renders hexokit.com's installer as an Expressive Code terminal block. The
 * bare one-liner is product-first (change d11j, D10): with no arguments it
 * installs shll + HexoKit and prints how to add the rest:
 *
 *     curl -fsSL https://hexokit.com/install | sh
 *
 * Tool-scoped forms append the tool names via `sh -s --`:
 *
 *     curl -fsSL https://hexokit.com/install | sh -s -- <tool>
 *
 * The same upstream script (sahil87/shll scripts/install.sh) serves both
 * forms — hexokit-site composes the product-first default onto its last line
 * at deploy time (scripts/compose-install.mjs), so the scoped line is
 * accurate and copy-pasteable per tool.
 *
 * THREE TOOL CLASSES:
 *
 * 1. `hexokit` (the product) renders the bare bootstrap line alone — its form
 *    IS the D10 default, matching the landing page. It is NOT in FULL_TOOLKIT:
 *    riff's `wt` dependency is probed at run time (install-composition
 *    Policy A), not pre-installed.
 * 2. `shll` renders the bootstrap line plus a follow-on block (`shll install`
 *    for the six companions, `shll setup shell`, `shll setup agent`,
 *    `exec $SHELL`). `shll` is the bootstrap meta-CLI, not a roster install
 *    target — `shll install shll` hard-errors (see toolkit/install and
 *    help/shll.json), so `sh -s -- shll` would be wrong.
 * 3. FULL_TOOLKIT tools (`fab-kit`) render a two-line block — the bootstrap
 *    line, then `shll install` — because their canonical READMEs (the
 *    constitution's source of truth — Tool-Page Depth) document the
 *    whole-toolkit install as the supported path: the tool relies on its
 *    siblings, so `sh -s -- <tool>` — while functional — would yield a
 *    degraded setup. Unlike `shll` they get no follow-on steps block; the
 *    note's link carries the visitor to the full guide.
 *
 * Every other tool (`idea`, `wt`, `tu`, `hop`) renders the `sh -s -- <tool>`
 * subset form.
 *
 * COPY BUTTON PARITY: the block is rendered via Starlight's re-exported
 * Expressive Code `<Code>` component — the same engine behind every fenced
 * code block on the site (toolkit/install, the commands/readme pages)
 * — so it carries the identical terminal frame styling (astro.config.mjs
 * expressiveCode styleOverrides) AND the one-click copy button. This replaced
 * the original hand-rolled `.shell-session` markup, whose only copy affordance
 * was text selection. The copy button's tiny script is EC's own, already
 * shipped by every page with a fenced block — no new dependency (the import
 * is a Starlight re-export, Constitution VI) and no new JS mechanism
 * (Constitution I's build-time discipline: the block is fully rendered at
 * build; EC's copy script is progressive enhancement the site already carries).
 *
 * SINGLE SOURCE: this component is the sole carrier of the per-tool one-liner.
 * It deliberately does NOT add seven hand-copied install blocks. The other
 * documented hand-written carriers — the homepage install block and
 * toolkit/install.md — describe the same two-step story (bootstrap, then
 * `shll install` for the rest) and are single-sourced separately.
 *
 * WHY AN .astro COMPONENT (not inline MDX): the command contains both `--` and
 * a bare URL. MDX runs remark plugins over JSX text — smartypants turns `--`
 * into an em-dash and bare URLs get auto-linked — so an inline MDX block would
 * mangle the copied command (see the remark-hazard note in index.mdx). Here the
 * command is built as a plain JS string and handed to `<Code>` as a prop, so
 * the literal `sh -s -- <tool>` and the URL survive verbatim — in the render
 * AND in what the copy button copies.
 *
 * The note's colors come from the site's --c-* tokens (src/styles/terminal.css),
 * and the EC frame colors are token-driven via astro.config.mjs, so dark-mode
 * parity is automatic (Constitution V).
 *
 * Placement convention: an `## Install` section between the overview's lead and
 * `## How it fits`. See docs/memory/conventions/tool-page-rubric.
 */
import { Code } from '@astrojs/starlight/components';
import { isToolSlug } from '../lib/tool-slugs.ts';

interface Props {
  /** Tool slug — selects the install form (bare bootstrap for hexokit, bootstrap + follow-on for shll, two-step for FULL_TOOLKIT tools, else the `sh -s -- <tool>` subset). */
  tool: string;
}

const { tool } = Astro.props as Props;

// A missing slug is a page-author error (the prop was forgotten) — fail the
// build loudly rather than emitting a broken `sh -s -- ` line, mirroring
// GithubButton's and CommandReference's top-level guards.
if (!tool) {
  throw new Error('InstallOneLiner: a `tool` slug prop is required.');
}

// An unknown slug would emit an install command for a tool that does not exist
// in the roster — a defect that must not deploy. Gate on the shared roster
// (the same isToolSlug gate every root-namespace dispatcher uses, change 3ke3).
if (!isToolSlug(tool)) {
  throw new Error(
    `InstallOneLiner: unknown tool slug \`${tool}\` — not one of the roster in src/lib/tool-slugs.ts.`,
  );
}

// `hexokit` is the product — the bare bootstrap line already installs it.
// `shll` bootstraps the toolkit — it is NOT a `shll install` target, so
// `sh -s -- shll` would hard-error.
const isProduct = tool === 'hexokit';
const isShll = tool === 'shll';

// Tools whose canonical README documents the WHOLE-toolkit install as the
// supported path — each relies on sibling tools, so `sh -s -- <tool>` would
// yield a degraded setup. Values are the per-tool reason clause, rendered in
// the note's shared sentence frame below; wording mirrors the canonical
// READMEs (the constitution's source of truth for tool docs).
const FULL_TOOLKIT: Record<string, string> = {
  'fab-kit': 'relies on its sibling tools (wt for worktrees, idea for the backlog)',
};
const fullToolkitReason = FULL_TOOLKIT[tool];

// The one-liner is built here (not in markdown) so the `--` and the URL
// never pass through any markdown/remark transform. The bootstrap line is
// single-sourced: the subset form appends `sh`'s args to the same base string.
const BOOTSTRAP_ONE_LINER = 'curl -fsSL https://hexokit.com/install | sh'; // installs shll + HexoKit

let codeBlock = BOOTSTRAP_ONE_LINER;
if (isShll) {
  // Follow-on steps after the bootstrap. Most visitors copy the one-liner and
  // assume they're done — surfacing the post-install steps right under it
  // keeps them from being missed. Command spellings follow help/shll.json
  // (`setup`, not the hidden shell-setup/agent-setup aliases); wording mirrors
  // the canonical block in toolkit/install.md.
  codeBlock = [
    BOOTSTRAP_ONE_LINER,
    '',
    'shll install              # the six companions',
    'shll setup shell           # wire your shell integration',
    'shll setup agent           # optional, once per machine',
    'exec $SHELL                # reload your shell',
  ].join('\n');
} else if (fullToolkitReason) {
  // Two-step whole-toolkit install: one copy button copies both commands.
  codeBlock = `${BOOTSTRAP_ONE_LINER}\nshll install`;
} else if (!isProduct) {
  codeBlock = `${BOOTSTRAP_ONE_LINER} -s -- ${tool}`;
}
---

<div class="install-one-liner not-content">
  <Code code={codeBlock} lang="bash" />
  {isProduct ? (
    <p class="install-one-liner-note">
      Installs <code>shll</code> and HexoKit via Homebrew — the six companions
      are one <code>shll install</code> away. See the <a
        href="/toolkit/install/">full install guide</a>.
    </p>
  ) : isShll ? (
    <p class="install-one-liner-note">
      Installs <code>shll</code> and HexoKit; <code>shll install</code> adds the
      rest of the toolkit — see the <a href="/toolkit/install/">full install
      guide</a>.
    </p>
  ) : fullToolkitReason ? (
    <p class="install-one-liner-note">
      Installs the entire <code>shll</code> toolkit via Homebrew —
      <code>{tool}</code> {fullToolkitReason}, so the full-toolkit install is
      the supported path. See the <a href="/toolkit/install/">full
      install guide</a>.
    </p>
  ) : (
    <p class="install-one-liner-note">
      Installs <code>shll</code> + <code>{tool}</code> via Homebrew — or <a
        href="/toolkit/install/">install the whole toolkit</a>.
    </p>
  )}
</div>

<style>
  /* The command block is Expressive Code (frame styling + copy button from the
     site-wide EC config in astro.config.mjs) — no terminal styling is
     duplicated here. The note's link styling also lives in terminal.css:
     change ld0j keeps every terminal-styled link in ONE selector group
     (.shell-session a, .home-prose a, .tools-listing a,
     .install-one-liner-note a) — one source, no per-class copies — so no link
     rules are duplicated here either. This scoped block is layout/typography
     only. */
  .install-one-liner {
    margin: 0.75rem 0 1.25rem;
  }
  .install-one-liner-note {
    margin: 0.65rem 0 0;
    font-family: var(--sl-font-mono);
    font-size: 0.85rem;
    color: var(--c-fg-dim);
  }
  .install-one-liner-note code {
    color: var(--c-fg);
  }
</style>
