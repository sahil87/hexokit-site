---
/**
 * Head — site-wide <head> override (`components.Head` in astro.config.mjs).
 *
 * Purpose: emit the Cloudflare Web Analytics beacon site-wide with its
 * `data-cf-beacon` JSON token un-escaped.
 *
 * Why an override and not Starlight's `head:` config array: the `head:` array
 * renders each entry via `<Tag {...attrs}>`, and Astro HTML-escapes attribute
 * values — so `data-cf-beacon='{"token": "..."}'` comes out as
 * `data-cf-beacon="{&quot;token&quot;: &quot;...&quot;}"`. Browsers decode that
 * back to valid JSON at runtime, but to ship the exact literal tag we render the
 * `<script>` via Fragment set:html here instead.
 *
 * Installed @astrojs/starlight 0.39.2's default Head takes NO props and renders
 * NO <slot /> — it maps over Astro.locals.starlightRoute.head. So the
 * version-correct override is a bare <Default /> (which still emits Starlight's
 * title/meta/canonical/favicon/fonts and any `head:` config entries), followed by
 * the literal beacon tag.
 *
 * Constitution I exception (client-side runtime JS): deliberate, user-approved,
 * scoped to analytics only, `defer`red — never blocks primary content. Cookieless,
 * so no consent gate. The token is a public site token (ships in page HTML), not
 * a secret — hardcoded by design.
 *
 * Production only: gated on `import.meta.env.PROD` (true during `astro build`, false
 * during `astro dev`) so local dev / preview sessions don't pollute the Cloudflare
 * dashboard with localhost traffic. The beacon still ships site-wide in `dist/`.
 *
 * Social-share meta (change kb1r): Starlight emits og:title/og:type/og:url/etc.
 * and `twitter:card=summary_large_image`, but NO og:image/twitter:image — so the
 * one shareable image asset (public/og-image.png, 1200×630, regenerated via
 * scripts/generate-og-image.mjs) was orphaned and link previews rendered bare
 * text cards. Appending the og:image set after <Default /> cannot double-emit
 * (Starlight has no og:image of its own). The URL MUST be absolute — OG scrapers
 * do not resolve relative URLs — so it derives from `site` in astro.config.mjs.
 *
 * JSON-LD (change kb1r, homepage only; HexoKit identity since change it5d): one
 * inert application/ld+json block carrying WebSite (name HexoKit) +
 * SoftwareApplication (name HexoKit, url = the product repo via the roster).
 * Emitted here (gated on pathname '/') rather than via index.mdx frontmatter
 * `head:` to keep the JSON authorable as a plain object — JSON.stringify never
 * produces `<` or raw HTML, so set:html is safe and the body survives emission
 * byte-exact. Inert data, not executable JS (no Constitution I conflict).
 *
 * Per-tool JSON-LD (change pgox; root namespace 3ke3; mount-gated it5d): the
 * homepage block above is one branch of a route DISPATCHER. Every per-tool page
 * emits its own inert application/ld+json @graph with two nodes — a per-tool
 * SoftwareApplication (name = the roster LABEL, e.g. HexoKit; description
 * single-sourced from help/<slug>.json `root.short`; url via the roster's repo)
 * and a BreadcrumbList with all `item` URLs absolute, derived from `Astro.site`.
 *
 * Route detection parses Astro.url.pathname (the same pathname-gate idiom as the
 * homepage branch, NOT starlightRoute.id) and GATES the first segment on the
 * roster's MOUNT set (`isToolMount` — a bare `/<x>/` shape would otherwise match
 * any root page). The segment is the mount (HexoKit's pages are `/docs/…`); the
 * slug is resolved via `slugForMount`. Coverage:
 *   - overview `/<mount>/`               (1 segment)  → no page crumb
 *   - readme/commands `/<mount>/<page>/` (2 segments) → page crumb
 * Breadcrumb shape: Home › Docs [› Readme|Commands] for the product (hexokit);
 * Home › Toolkit (→ /toolkit/) › <label> [› page] for the companions. Nested
 * docs-site pages (2+ segments where <page> is not readme/commands) stay
 * uncovered — parity with the pre-it5d coverage. The homepage block and the
 * per-tool branch are mutually exclusive (`/` never matches a tool path).
 *
 * Failure split (mirrors CommandReference.astro, NOT VersionTable's build-stop —
 * this is inert SEO metadata, not a correctness-critical committed artifact):
 *   - MISSING help/<slug>.json (ENOENT) → emit the SoftwareApplication node
 *     WITHOUT its `description` field and continue the build (an absent producer
 *     file is an expected interim state; the BreadcrumbList needs no help JSON
 *     and always emits).
 *   - PRESENT but schema-invalid → HelpDocSchema.parse throws (wrapped with the
 *     filename) so `astro build` FAILS (a committed malformed file is a defect).
 */
import fs from 'node:fs';
import path from 'node:path';
import { HelpDocSchema } from '../lib/schemas.ts';
import { repoRootFromModuleUrl } from '../lib/repo-root.ts';
import { isToolMount, slugForMount, labelFor, repoFor } from '../lib/tool-slugs.ts';
import Default from '@astrojs/starlight/components/Head.astro';

const beacon =
  '<script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon=\'{"token": "11bda8377391420f9138b4cf3128dc6e"}\'></script>';

const siteOrigin = new URL('/', Astro.site).origin;
const ogImage = new URL('/og-image.png', Astro.site).href;
const ogImageAlt = 'HexoKit — your tmux, in the browser and on your phone';

const isHomepage = Astro.url.pathname === '/';
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: 'HexoKit',
      url: siteOrigin,
    },
    {
      '@type': 'SoftwareApplication',
      name: 'HexoKit',
      description: 'Your tmux, in the browser and on your phone.',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'macOS, Linux',
      offers: { '@type': 'Offer', price: 0, priceCurrency: 'USD' },
      url: `https://github.com/sahil87/${repoFor('hexokit')}`,
    },
  ],
});

// --- Per-tool JSON-LD branch (change pgox; root namespace 3ke3; mounts it5d) --
// Mutually exclusive with the homepage branch above: a tool page can never be
// `/`, and `/` never matches the tool-page shapes. Parse pathname for the same
// reason the homepage uses pathname (one consistent gate idiom in this file).
const rootSegments = Astro.url.pathname.replace(/^\/+|\/+$/g, '').split('/');

/** Reserved per-tool page slugs → display labels for the breadcrumb page crumb. */
const PAGE_LABELS: Record<string, string> = {
  readme: 'Readme',
  commands: 'Commands',
};

/** `{ slug, mount, page }` when the pathname is a covered per-tool page, else
 *  null. `page` is null for the overview (1-segment) shape. The first segment
 *  is the MOUNT (gated on `isToolMount`); `slug` is resolved from it. */
let toolPage: { slug: string; mount: string; page: string | null } | null = null;
if (rootSegments.length === 1 && isToolMount(rootSegments[0])) {
  toolPage = { slug: slugForMount(rootSegments[0])!, mount: rootSegments[0], page: null };
} else if (
  rootSegments.length === 2 &&
  isToolMount(rootSegments[0]) &&
  Object.hasOwn(PAGE_LABELS, rootSegments[1])
) {
  toolPage = { slug: slugForMount(rootSegments[0])!, mount: rootSegments[0], page: rootSegments[1] };
}

let toolJsonLd: string | null = null;
if (toolPage) {
  const { slug, mount, page } = toolPage;

  // SoftwareApplication: name is the roster LABEL (HexoKit for /docs/ pages);
  // url is the roster repo (hexokit's stays run-kit until the source rename).
  // description is single-sourced from help/<slug>.json `root.short`.
  const softwareApplication: Record<string, unknown> = {
    '@type': 'SoftwareApplication',
    name: labelFor(slug),
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'macOS, Linux',
    offers: { '@type': 'Offer', price: 0, priceCurrency: 'USD' },
    url: `https://github.com/sahil87/${repoFor(slug)}`,
  };

  const helpPath = path.join(repoRootFromModuleUrl(import.meta.url), 'help', `${slug}.json`);
  let raw: string | undefined;
  try {
    raw = fs.readFileSync(helpPath, 'utf8');
  } catch (err) {
    // MISSING (ENOENT) → omit `description` only, keep building. Anything else
    // (e.g. EACCES) is a real fault — rethrow.
    if ((err as NodeJS.ErrnoException).code !== 'ENOENT') throw err;
  }
  if (raw !== undefined) {
    // PRESENT but invalid → let parse throw, wrapped with the filename, so the
    // build FAILS (a committed malformed help file is a defect).
    let doc;
    try {
      doc = HelpDocSchema.parse(JSON.parse(raw));
    } catch (err) {
      const detail = err instanceof Error ? err.message : String(err);
      throw new Error(
        `Head: invalid help document at ${helpPath} — does not match HelpDocSchema:\n${detail}`,
      );
    }
    // Attach `description` (single-sourced from help/<slug>.json `root.short`).
    // Assigned after object creation, so it lands as the last key — key order is
    // cosmetic in JSON-LD anyway; consumers key by name, not position.
    softwareApplication.description = doc.root.short;
  }

  // BreadcrumbList: all `item` URLs absolute, derived from Astro.site — never
  // hardcode the origin (`site: 'https://hexokit.com'` is the single source).
  // The second crumb is `Docs` (→ /docs/) for the product and `Toolkit`
  // (→ /toolkit/) for the companions; the tool crumb points at the tool's
  // canonical root `/<mount>/`. The page crumb is present only for
  // readme/commands; the overview page has no extra crumb (it IS the tool
  // crumb's destination).
  const isProduct = slug === 'hexokit';
  const itemListElement: Record<string, unknown>[] = [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
    isProduct
      ? { '@type': 'ListItem', position: 2, name: 'Docs', item: new URL(`/${mount}/`, Astro.site).href }
      : { '@type': 'ListItem', position: 2, name: 'Toolkit', item: new URL('/toolkit/', Astro.site).href },
  ];
  if (!isProduct) {
    itemListElement.push({
      '@type': 'ListItem',
      position: 3,
      name: labelFor(slug),
      item: new URL(`/${mount}/`, Astro.site).href,
    });
  }
  if (page) {
    itemListElement.push({
      '@type': 'ListItem',
      position: itemListElement.length + 1,
      name: PAGE_LABELS[page],
      item: new URL(`/${mount}/${page}/`, Astro.site).href,
    });
  }
  const breadcrumbList = {
    '@type': 'BreadcrumbList',
    itemListElement,
  };

  toolJsonLd = JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [softwareApplication, breadcrumbList],
  });
}
---

<Default />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />
<meta name="twitter:image" content={ogImage} />
{isHomepage && <script type="application/ld+json" set:html={jsonLd} />}
{toolJsonLd && <script type="application/ld+json" set:html={toolJsonLd} />}
{import.meta.env.PROD && <Fragment set:html={beacon} />}
