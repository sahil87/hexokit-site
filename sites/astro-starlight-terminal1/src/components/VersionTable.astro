---
/**
 * VersionTable — the homepage `$ shll version` dump, self-updating at BUILD TIME.
 *
 * Renders one `<span class="shell-line">` per tool, reproducing the terminal-themed
 * markup the homepage used to hand-write (route link · version · [git] link). The
 * ONLY value pulled from data is the `version` string: it is read from each tool's
 * `<repo-root>/help/<slug>.json` and validated against `HelpDocSchema`. Everything
 * else — the roster, display order, display labels, route links, and repo URLs —
 * comes from the shared roster (`src/lib/tool-roster.mjs`, change it5d; the route
 * is `/<mount>` and the repo is `repoFor(slug)`, which differ from the slug for
 * HexoKit). Reading versions from the already-synced
 * `help/*.json` (committed by the scheduled puller) makes the block self-correcting:
 * a future version bump shows up on the next rebuild with no source edit, and there
 * is no runtime fetch (Constitution I, static-first).
 *
 * The repo-root `help/` dir is resolved by ascending from `import.meta.url` — the
 * same marker-search pattern CommandIndex/CommandReference use, for the same Vite
 * bundled-chunk-depth reason. A rostered `help/<slug>.json` that is MISSING or fails
 * schema validation is a build-stopping condition (a committed defect must not
 * deploy) — mirroring CommandIndex.astro.
 */
import fs from 'node:fs';
import path from 'node:path';
import { HelpDocSchema } from '../lib/schemas.ts';
import { repoRootFromModuleUrl } from '../lib/repo-root.ts';
import { normalizeVersion } from '../lib/version.ts';
import { TOOL_ROSTER } from '../lib/tool-slugs.ts';

interface RosterEntry {
  /** help/<slug>.json file slug (e.g. "hexokit"). */
  slug: string;
  /** Display label from the roster (e.g. "HexoKit"). */
  label: string;
  /** Docs route on this site (`/<mount>`). */
  route: string;
  /** Canonical repo URL. */
  repo: string;
}

/**
 * The roster is single-sourced from tool-roster.mjs (change it5d): display
 * order (product first, then the hexagon order, then shll), labels, routes, and
 * repos are derived, never re-listed.
 */
const ROSTER: RosterEntry[] = TOOL_ROSTER.map((t) => ({
  slug: t.slug,
  label: t.label,
  route: `/${t.mount}`,
  repo: `https://github.com/sahil87/${t.repo}`,
}));

/** Column widths reproducing the original hand-written alignment (white-space: pre). */
const LABEL_COL = 9;
const VERSION_COL = 10;

const repoRoot = repoRootFromModuleUrl(import.meta.url);
const helpDir = path.join(repoRoot, 'help');

interface VersionRow extends RosterEntry {
  version: string;
}

const rows: VersionRow[] = ROSTER.map((entry) => {
  const file = path.join(helpDir, `${entry.slug}.json`);
  let raw: string;
  try {
    raw = fs.readFileSync(file, 'utf8');
  } catch (err) {
    const detail = err instanceof Error ? err.message : String(err);
    throw new Error(
      `VersionTable: required help document missing at ${file} (rostered tool "${entry.slug}"):\n${detail}`,
    );
  }
  let doc;
  try {
    doc = HelpDocSchema.parse(JSON.parse(raw));
  } catch (err) {
    const detail = err instanceof Error ? err.message : String(err);
    throw new Error(
      `VersionTable: invalid help document at ${file} — does not match HelpDocSchema:\n${detail}`,
    );
  }
  return { ...entry, version: normalizeVersion(doc.version) };
});

/** Trailing padding so the version column starts at LABEL_COL. */
function labelPad(label: string): string {
  return ' '.repeat(Math.max(1, LABEL_COL - label.length));
}
/** Trailing padding so the [git] link starts at VERSION_COL after the version. */
function versionPad(version: string): string {
  return ' '.repeat(Math.max(1, VERSION_COL - version.length));
}
---

{rows.map((row) => (
  <span class="shell-line"><a href={row.route}>{row.label}</a>{labelPad(row.label)}<span class="shell-dim">{row.version}</span>{versionPad(row.version)}<a class="shell-dim" href={row.repo}>[git]</a></span>
))}
